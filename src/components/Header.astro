							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>

				<a href="https://medium.com/@akiff.fazill" target="_blank" rel="noopener noreferrer" aria-label="Medium profilim">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 30 30" aria-hidden="true">
						<path fill="currentColor" d="M8.5 7A8.5 8.5 0 108.5 24 8.5 8.5 0 108.5 7zM22 8A4 7.5 0 1022 23 4 7.5 0 1022 8zM28.5 9A1.5 6.5 0 1028.5 22 1.5 6.5 0 1028.5 9z"></path>
					</svg>
				</a>

				<a href="https://www.linkedin.com/in/akif-f-güven-087783217/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profilim">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="20" height="20" aria-hidden="true">
						<path
							fill="currentColor"
							d="M218.123 218.127h-37.931v-59.403c0-14.165-.253-32.4-19.728-32.4c-19.756 0-22.779 15.434-22.779 31.369v60.43h-37.93V95.967h36.413v16.694h.51a39.91 39.91 0 0 1 35.928-19.733c38.445 0 45.533 25.288 45.533 58.186zM56.955 79.27c-12.157.002-22.014-9.852-22.016-22.009s9.851-22.014 22.008-22.016c12.157-.003 22.014 9.851 22.016 22.008A22.013 22.013 0 0 1 56.955 79.27m18.966 138.858H37.95V95.967h37.97zM237.033.018H18.89C8.58-.098.125 8.161-.001 18.471v219.053c.122 10.315 8.576 18.582 18.89 18.474h218.144c10.336.128 18.823-8.139 18.966-18.474V18.454c-.147-10.33-8.635-18.588-18.966-18.453"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(var(--accent-light), 0.95);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(var(--accent), 0.1);
		transition: all 0.3s ease;
	}

	nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		position: relative;
	}

	.nav-brand h2 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
	}

	.nav-brand a {
		color: rgb(var(--accent));
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.nav-brand a:hover {
		color: rgb(var(--accent-dark));
	}

	.mobile-menu-btn {
		display: none;
		flex-direction: column;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		gap: 0.25rem;
		z-index: 101;
	}

	.hamburger {
		width: 20px;
		height: 2px;
		background: rgb(var(--accent));
		transition: all 0.3s ease;
		transform-origin: center;
	}

	.mobile-menu-btn[aria-expanded="true"] .hamburger:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}

	.mobile-menu-btn[aria-expanded="true"] .hamburger:nth-child(2) {
		opacity: 0;
	}

	.mobile-menu-btn[aria-expanded="true"] .hamburger:nth-child(3) {
		transform: rotate(-45deg) translate(7px, -6px);
	}

	.nav-content {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.internal-links {
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}

	.social-links {
		display: flex;
		gap: 1rem;
		align-items: center;
	}

	.social-links a {
		display: flex;
		align-items: center;
		padding: 0.5rem;
		border-radius: 0.5rem;
		color: rgb(var(--accent));
		transition: all 0.3s ease;
		background: transparent;
	}

	.social-links a:hover {
		background: rgba(var(--accent), 0.1);
		color: rgb(var(--accent-dark));
		transform: translateY(-2px);
	}

	.social-links svg {
		transition: transform 0.3s ease;
	}

	.social-links a:hover svg {
		transform: scale(1.1);
	}

	/* Mobile styles */
	@media (max-width: 768px) {
		nav {
			padding: 1rem;
		}

		.mobile-menu-btn {
			display: flex;
		}

		.nav-content {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: rgba(var(--accent-light), 0.98);
			backdrop-filter: blur(15px);
			border-bottom: 1px solid rgba(var(--accent), 0.1);
			flex-direction: column;
			gap: 1.5rem;
			padding: 1.5rem;
			transform: translateY(-100%);
			opacity: 0;
			visibility: hidden;
			transition: all 0.3s ease;
		}

		.nav-content.active {
			transform: translateY(0);
			opacity: 1;
			visibility: visible;
		}

		.internal-links {
			flex-direction: column;
			gap: 1rem;
			width: 100%;
		}

		.social-links {
			justify-content: center;
			gap: 1.5rem;
		}
	}

	/* Tablet styles */
	@media (max-width: 1024px) and (min-width: 769px) {
		.nav-content {
			gap: 1.5rem;
		}

		.internal-links {
			gap: 1rem;
		}
	}
</style>

<script>
	// Mobile menu functionality
	const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
	const navContent = document.querySelector('.nav-content');

	if (mobileMenuBtn && navContent) {
		mobileMenuBtn.addEventListener('click', () => {
			const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
			mobileMenuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
			navContent.classList.toggle('active');
		});

		// Close menu when clicking outside
		document.addEventListener('click', (e) => {
			if (!mobileMenuBtn.contains(e.target) && !navContent.contains(e.target)) {
				mobileMenuBtn.setAttribute('aria-expanded', 'false');
				navContent.classList.remove('active');
			}
		});

		// Close menu on escape key
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				mobileMenuBtn.setAttribute('aria-expanded', 'false');
				navContent.classList.remove('active');
			}
		});
	}
</script>
