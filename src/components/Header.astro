---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="nav-brand">
			<h2><a href="/">{SITE_TITLE}</a></h2>
		</div>
		
		<!-- Mobile menu button -->
		<button class="mobile-menu-btn" aria-label="Menu" aria-expanded="false">
			<span class="hamburger"></span>
			<span class="hamburger"></span>
			<span class="hamburger"></span>
		</button>

		<div class="nav-content">
			<div class="internal-links">
				<HeaderLink href="/">Anasayfa</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/about">Hakkımda</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://github.com/zhoommer" target="_blank" rel="noopener noreferrer" aria-label="GitHub profilim">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
